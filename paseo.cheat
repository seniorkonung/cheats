% paseo, setup

# Установить paseo и все плагины его

codex_orchestrator=$(
cat <<'EOF'
{
    "extends": "codex",
    "label": "Codex Orchestrator",
    "paseoTools": {
        "enabled": true
    }
}
EOF
); claude_orchestrator=$(
cat <<'EOF'
{
    "extends": "claude",
    "label": "Claude Orchestrator",
    "paseoTools": {
        "enabled": true
    }
}
EOF
); paseo_tools=$(
cat <<'EOF'
{
    "enabled": false
}
EOF
); features=$(
cat <<'EOF'
{
    "dictation": {
        "enabled": false
    },
    "voiceMode": {
        "enabled": false
    }
}
EOF
); daemon_mcp=$(
cat <<'EOF'
{
    "enabled": true,
    "injectIntoAgents": true
}
EOF
); mise use -g npm:@getpaseo/cli@0.8.0-beta.1 \
    && mise set -g PASEO_HOST=<ip>:6767 \
    && jq \
        --argjson codex_orchestrator "$codex_orchestrator" \
        --argjson claude_orchestrator "$claude_orchestrator" \
        --argjson paseo_tools "$paseo_tools" \
        --argjson features "$features" \
        --argjson daemon_mcp "$daemon_mcp" \
        '
            .agents.providers["codex-orchestrator"] = $codex_orchestrator
            | .agents.providers["claude-orchestrator"] = $claude_orchestrator
            | .agents.providers["codex"].paseoTools = $paseo_tools
            | .agents.providers["claude"].paseoTools = $paseo_tools
            | .features = $features
            | .daemon.mcp = $daemon_mcp
        ' ~/.paseo/config.json > /tmp/paseo-config.json.tmp \
    && mv /tmp/paseo-config.json.tmp ~/.paseo/config.json \
    && paseo plugin add seniorkonung/paseo-openspec-orchestrator \
    && paseo plugin add seniorkonung/paseo-mise-env \
    && paseo plugin add seniorkonung/paseo-ntfy \

$ ip: hostname -I | tr ' ' '\n' | sed '/^$/d' --- --prevent-extra

% paseo, plugin, update

# Обновить выбранный плагин до новой версии
paseo plugin update <plugin-name>

$ plugin-name: paseo plugin ls --json | jq -r '.[].id'

% paseo, daemon, start
@ paseo, setup

# Запустить демон paseo
paseo daemon start --listen $PASEO_HOST

% paseo, session, import

# Импортировать сессию codex в paseo
paseo import --provider codex <session-uuid>

% paseo, session, reload

# Обновить историю сессии, которая была продолжена вне paseo
paseo agent reload <session-id>

$ session-id: printf "" --- --header "Предварительно нужно узнать его командой paseo agent ls --host ..."

% paseo, session, list

# Посмотреть список всех сессий
paseo agent ls

% paseo, workspace, add

# Добавить новую папку с проектом
paseo workspace create --isolation local --path <folder> --title <title>

$ folder: find "$HOME/projects" \
    -mindepth 1 \
    -maxdepth 1 \
    -type d \
    -print \
    --- --prevent-extra

$ title: basename "$folder"
